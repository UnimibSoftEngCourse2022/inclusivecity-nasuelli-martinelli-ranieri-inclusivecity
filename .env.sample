# --- FIREBASE (Notifiche Push) ---
VITE_FIREBASE_API_KEY="api_key"
VITE_FIREBASE_PROJECT_ID="project_id"
VITE_FIREBASE_MESSAGING_SENDER_ID="sender_id"
VITE_FIREBASE_APP_ID="app_id"
VITE_FIREBASE_VAPID_KEY="vapid_key"

# --- MAPBOX (Rendering Mappa e Geocoding) ---
VITE_MAPBOX_TOKEN="pk.mapbox_token"

# --- OPENROUTESERVICE (Calcolo Percorsi Accessibili) ---
VITE_ORS_API_KEY="ors_token"

# --- SUPABASE (Auth & Storage) ---
VITE_SUPABASE_URL="https://[TUO_PROGETTO].supabase.co"
VITE_SUPABASE_ANON_KEY="anon_key"

# --- PRISMA & DATABASE (Supabase Postgres) ---
DATABASE_URL="postgresql://postgres.[PROGETTO]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROGETTO]:[PASSWORD]@[HOST]:5432/postgres"
